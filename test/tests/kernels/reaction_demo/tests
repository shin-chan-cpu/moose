[Tests]
  # Test steady-state solution with both manual and AD implementations
  [steady_manual]
    type = 'Exodiff'
    input = 'steady_reaction.i'
    cli_args = 'Outputs/file_base=steady_manual_out Kernels/reaction_manual/type=DemoReaction Kernels/diff_manual/type=Diffusion BCs/left_manual/type=DirichletBC BCs/right_manual/type=DirichletBC'
    exodiff = 'steady_manual_out.e'
    requirement = 'The system shall solve a steady reaction-diffusion problem using manual Jacobian computation.'
  []
  
  [steady_ad]
    type = 'Exodiff'
    input = 'steady_reaction.i'
    cli_args = 'Outputs/file_base=steady_ad_out Kernels/reaction_ad/type=ADDemoReaction Kernels/diff_ad/type=ADDiffusion BCs/left_ad/type=ADDirichletBC BCs/right_ad/type=ADDirichletBC'
    exodiff = 'steady_ad_out.e'
    requirement = 'The system shall solve a steady reaction-diffusion problem using automatic differentiation.'
  []

  # Test that manual and AD solutions match within tolerance
  [steady_comparison]
    type = 'Exodiff'
    input = 'steady_reaction.i'
    cli_args = 'Outputs/file_base=steady_comparison_out'
    exodiff = 'steady_comparison_out.e'
    abs_zero = 1e-9
    requirement = 'The system shall produce identical solutions for manual and AD reaction kernels.'
  []

  # Test Jacobian correctness for manual implementation
  [jacobian_manual]
    type = PetscJacobianTester
    input = 'jacobian_test.i'
    cli_args = 'Variables/u_manual/initial_condition=0.1'
    requirement = 'The system shall compute a correct Jacobian for the manual reaction kernel implementation.'
  []

  # Test Jacobian correctness for AD implementation
  [jacobian_ad]
    type = PetscJacobianTester
    input = 'jacobian_test.i'
    cli_args = 'Variables/u_ad/initial_condition=0.1'
    requirement = 'The system shall compute a perfect Jacobian for the AD reaction kernel implementation.'
  []

  # Test transient solution
  [transient]
    type = 'Exodiff'
    input = 'transient_reaction.i'
    cli_args = 'Outputs/file_base=transient_out end_time=1.0 dt=0.2'
    exodiff = 'transient_out.e'
    requirement = 'The system shall solve a transient reaction-diffusion problem with both manual and AD kernels.'
  []

  # Test parameter sensitivity
  [reaction_rate_test]
    type = 'Exodiff'
    input = 'steady_reaction.i'
    cli_args = 'Kernels/reaction_manual/reaction_rate=5.0 Kernels/reaction_ad/reaction_rate=5.0 Outputs/file_base=reaction_rate_out'
    exodiff = 'reaction_rate_out.e'
    requirement = 'The system shall handle different reaction rate parameters correctly.'
  []

  # Test reaction-only problem
  [reaction_only]
    type = 'Exodiff'
    input = 'reaction_only.i'
    exodiff = 'reaction_only_out.e'
    requirement = 'The system shall solve a reaction-only problem with both manual and AD kernels.'
  []
[]
[]